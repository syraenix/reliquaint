# Example Amiga manifest. Rename to <id>.toml to activate.
# Discovery skips files with the .disabled extension.

id         = "example-amiga-game"
title      = "Example Amiga Game"
platform   = "amiga"
collection = "example-collection"

[runtime]
emulator = "fs-uae"
file     = "../games/example.adf"   # relative to this manifest file
model    = "a500"                   # "a500" | "a1200"; ignored if .rp9 ships .fs-uae config
# config = "../config/custom.fs-uae"  # optional explicit config override

# [ui]
# artwork = "../img/example-cover.png"

# NOTE: Amiga manifests do NOT have [install] or runtime.sidecars.
